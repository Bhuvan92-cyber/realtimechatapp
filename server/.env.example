# Backend environment variables.
# Copy this file to `.env` and fill in the values, or export them in your shell.

# Port the Express + Socket.io server listens on.
PORT=3001

# Supabase project URL and service-role key (used to persist messages).
# The service role key bypasses RLS — safe here because this runs server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of allowed origins for CORS / Socket.io.
# In development, include the Expo web dev server origin.
CLIENT_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
